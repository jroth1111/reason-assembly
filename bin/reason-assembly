#!/bin/sh
set -eu

launcher=$0
while [ -L "$launcher" ]; do
  link=$(readlink "$launcher")
  case "$link" in
    /*) launcher=$link ;;
    *) launcher=$(dirname -- "$launcher")/$link ;;
  esac
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd)
project_dir=$(dirname -- "$script_dir")

# Source checkouts require uv; installed wheels provide a native console script.
exec uv run --quiet --project "$project_dir" \
  python -m reason_assembly "$@"
